{
  "db-postgres": {
    "display_name": "PostgreSQL",
    "type": "DB",
    "adapter": "postgres_read",
    "package": "postgres-mcp",
    "version": "0.3.0",
    "executable": "postgres-mcp",
    "args": ["--access-mode=restricted"],
    "env": {},
    "auth_env": ["DATABASE_PASSWORD"],
    "capabilities": [{"capability_id": "query", "tool_name": "execute_sql", "constraints": {"sql_field": "sql", "tables": ["*"], "columns": ["*"], "max_rows": 100}}],
    "source": "https://github.com/crystaldba/postgres-mcp"
  },
  "cache-redis": {
    "display_name": "Redis",
    "type": "Cache",
    "adapter": "redis_read",
    "package": "redis-mcp-server",
    "version": "0.5.1",
    "executable": "redis-mcp-server",
    "args": [],
    "env": {"REDIS_HOST": "", "REDIS_PORT": "6379", "REDIS_DB": "0", "REDIS_SSL": "true"},
    "auth_env": ["REDIS_PWD"],
    "capabilities": [{"capability_id": "read-key", "tool_name": "get", "constraints": {}}],
    "source": "https://github.com/redis/mcp-redis"
  },
  "infra-aws": {
    "display_name": "AWS",
    "type": "Infra",
    "adapter": "aws_read",
    "package": "awslabs.aws-api-mcp-server",
    "version": "1.5.6",
    "executable": "awslabs.aws-api-mcp-server",
    "args": [],
    "env": {"READ_OPERATIONS_ONLY": "true", "AWS_API_MCP_TELEMETRY": "false", "AWS_PROFILE": "", "AWS_REGION": ""},
    "auth_env": [],
    "capabilities": [{"capability_id": "describe", "tool_name": "call_aws", "constraints": {"command_field": "cli_command", "region": ""}}],
    "source": "https://awslabs.github.io/mcp/servers/aws-api-mcp-server/"
  },
  "source-gitlab": {
    "display_name": "GitLab",
    "type": "Source",
    "adapter": "gitlab_read",
    "package": "mcp-gitlab",
    "version": "0.21.0",
    "executable": "mcp-gitlab",
    "args": [],
    "env": {"MCP_READ_ONLY": "true", "GITLAB_URL": "", "GITLAB_SSL_VERIFY": "true"},
    "auth_env": ["GITLAB_TOKEN"],
    "capabilities": [{"capability_id": "read-file", "tool_name": "gitlab_get_file", "constraints": {}}],
    "source": "https://github.com/vish288/mcp-gitlab"
  },
  "document-confluence": {
    "display_name": "Confluence",
    "type": "Document",
    "adapter": "confluence_read",
    "package": "mcp-atlassian",
    "version": "0.23.1",
    "executable": "mcp-atlassian",
    "args": [],
    "env": {"READ_ONLY_MODE": "true", "ENABLED_TOOLS": "confluence_get_page", "CONFLUENCE_URL": "", "CONFLUENCE_USERNAME": ""},
    "auth_env": ["CONFLUENCE_API_TOKEN"],
    "capabilities": [{"capability_id": "read-page", "tool_name": "confluence_get_page", "constraints": {}}],
    "source": "https://github.com/sooperset/mcp-atlassian"
  }
}
